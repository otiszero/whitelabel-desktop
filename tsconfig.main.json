{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-electron",
    "rootDir": "src",
    "resolveJsonModule": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@crypto/*": ["src/crypto/*"],
      "@config/*": ["src/config/*"]
    }
  },
  "include": ["src/main/**/*", "src/crypto/**/*"],
  "exclude": ["node_modules", "src/main/preload.ts"]
}
